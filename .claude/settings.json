{
  "enabledPlugins": {
    "expo@claude-plugins-official": true
  },
  "permissions": {
    "defaultMode": "plan",
    "allow": [
      "Edit(./claude/*)",
      "Write(./claude/*)",
      "Bash(git status)",
      "Bash(git diff *)",
      "Read(/**)",
      "Bash(pnpm run:*)",
      "Bash(pnpm test:*)",
      "Bash(pnpm list:*)",
      "Bash(pnpm why:*)",
      "Bash(bash scripts/check.sh)",
      "Bash(pnpm exec tsc:*)",
      "Bash(pnpm exec eslint:*)",
      "Bash(pnpm exec prettier:*)",
      "Bash(pnpm exec jest:*)",
      "Bash(pnpm exec tsx:*)",
      "Bash(pnpm exec expo install:*)",
      "Bash(pnpm dlx expo-doctor:*)",
      "Bash(pnpm exec drizzle-kit:*)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git show:*)",
      "Bash(git branch:*)",
      "Bash(ls:*)",
      "Bash(find:*)",
      "Bash(rg:*)",
      "Bash(wc:*)",
      "Bash(mkdir:*)"
    ],
    "ask": [
      "Bash(git add:*)",
      "Bash(git push *)",
      "Bash(git commit *)"
    ],
    "deny": [
      "Read(.env)",
      "Bash(rm -rf *)",
      "Read(./.env)",
      "Read(./.env.*)",
      "Edit(./ios/**)",
      "Edit(./android/**)",
      "Edit(./node_modules/**)",
      "Edit(./src/db/migrations/**)",
      "Bash(git reset --hard:*)",
      "Bash(git clean:*)",
      "Bash(rm -rf:*)",
      "Bash(pnpm audit --fix:*)"
    ]
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR/.claude/hooks/format-changed.sh\"",
            "timeout": 30
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR/.claude/hooks/verify-on-stop.sh\"",
            "timeout": 300
          }
        ]
      }
    ]
  }
}
